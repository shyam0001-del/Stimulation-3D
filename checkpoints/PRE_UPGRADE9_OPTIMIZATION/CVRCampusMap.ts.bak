    s2b.position.set(25.0, 0.35, -150.0);
    this.disposables.push(s1.geometry, s2.geometry, s2b.geometry);
    this.group.add(s1, s2, s2b);

    // 1c. FIRST LEFT CONNECTION: Drivable Entrance into Bus Bay (z = -144.0 to -132.0, length 12.0m, center z = -138.0)

    this.addBox(42.3, 0.17, -179.0, 0.35, 0.35, 14.0, this.materials.curbStripe, 0);

    // 1b. Long Divided Entrance Road Section (Approved Layout: z = -172.0 to -115.0, length 57.0m, center z = -143.5)

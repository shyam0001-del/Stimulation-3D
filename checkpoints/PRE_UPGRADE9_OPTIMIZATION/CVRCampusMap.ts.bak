      mainBlockBeige: new THREE.MeshLambertMaterial({ color: 0xdfc196 }),
      academicWall: new THREE.MeshLambertMaterial({ color: 0xe5dcc5 }),
      academicCornice: new THREE.MeshLambertMaterial({ color: 0xc7b99e }),
